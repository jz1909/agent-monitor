[65.954182, "i", "cat > reproduce-cache.js <<'EOF'\nconst api = require('./api');\nconst pin = require('./api/pin');\n\nfunction makeRes(label) {\n  return {\n    headers: {},\n    setHeader(key, value) {\n      this.headers[key] = value;\n    },\n    send(body) {\n      console.log(label, this.headers, typeof body === 'string' ? body.slice(0, 40) : body);\n    },\n  };\n}\n\n(async () => {\n  const res1 = makeRes('api');\n  await api({ query: { username: 'anuraghazra', cache_seconds: '7200' } }, res1);\n\n  const res2 = makeRes('pin');\n  await pin({ query: { username: 'anuraghazra', repo: 'github-readme-stats', cache_seconds: '7200' } }, res2);\n})();\nEOF\nnode reproduce-cache.js\n"]
