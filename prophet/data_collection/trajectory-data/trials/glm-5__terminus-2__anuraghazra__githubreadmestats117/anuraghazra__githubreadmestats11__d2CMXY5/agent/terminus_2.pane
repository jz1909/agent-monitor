[?2004lfunction clampValue(value, min, max) {
  if (value < min) {
    return min;
  }
  if (value > max) {
    return max;
  }
  return value;
}

module.exports = {
  renderError,
  kFormatter,
  encodeHTML,
  isValidHexColor,
  request,
  parseBoolean,
  fallbackColor,
  FlexLayout,
  getCardColors,
  clampValue,
};
