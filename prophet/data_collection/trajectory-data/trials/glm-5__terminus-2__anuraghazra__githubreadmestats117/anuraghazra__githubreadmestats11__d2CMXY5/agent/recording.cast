[108.082363, "o", "{\r\n  \"name\": \"github-readme-stats\",\r\n  \"version\": \"1.0.0\",\r\n  \"description\": \"Dynamically generate stats for your github readmes\",\r\n  \"main\": \"index.js\",\r\n  \"scripts\": {\r\n    \"test\": \"jest\",\r\n    \"test:watch\": \"jest --watch\"\r\n  },\r\n  \"author\": \"Anurag Hazra\",\r\n  \"license\": \"MIT\",\r\n  \"devDependencies\": {\r\n    \"@testing-library/dom\": \"^7.20.0\",\r\n    \"@testing-library/jest-dom\": \"^5.11.0\",\r\n    \"axios\": \"^0.19.2\",\r\n    \"axios-mock-adapter\": \"^1.18.1\",\r\n    \"css-to-object\": \"^1.1.0\",\r\n    \"jest\": \"^26.1.0\"\r\n  },\r\n  \"dependencies\": {\r\n    \"dotenv\": \"^8.2.0\"\r\n  }\r\n}\r\n"]
