[524.799225, "i", "cat > /tmp/test_cache.js << 'EOF'\n// Test script to verify cache implementation\nconst axios = require(\"axios\");\nconst MockAdapter = require(\"axios-mock-adapter\");\n\nconst api = require(\"./api/index\");\nconst pin = require(\"./api/pin\");\n\nconst mock = new MockAdapter(axios);\n\n// Test data for stats\nconst statsData = {\n  data: {\n    user: {\n      name: \"Test User\",\n      repositoriesContributedTo: { totalCount: 100 },\n      contributionsCollection: { totalCommitContributions: 200 },\n      pullRequests: { totalCount: 50 },\n      issues: { totalCount: 30 },\n      followers: { totalCount: 10 },\n      repositories: {\n        totalCount: 5,\n        nodes: [{ stargazers: { totalCount: 100 } }],\n      },\n    },\n  },\n};\n\n// Test data for repo\nconst repoData = {\n  data: {\n    user: {\n      repository: {\n        username: \"test\",\n        name: \"test-repo\",\n        stargazers: { totalCount: 100 },\n        description: \"Test repo\",\n        primaryLanguage: { color: \"#000\", name: \"JavaScript\" },\n        forkCount: 10,\n      },"]
[524.799322, "i", "\n    },\n    organization: null,\n  },\n};\n\nasync function testDefaultCache() {\n  mock.onPost(\"https://api.github.com/graphql\").reply(200, statsData);\n  \n  const req = { query: { username: \"test\" } };\n  const res = {\n    setHeader: jest.fn(),\n    send: jest.fn(),\n  };\n  \n  await api(req, res);\n  \n  // Check that Cache-Control is set with default value\n  const cacheCall = res.setHeader.mock.calls.find(call => call[0] === \"Cache-Control\");\n  console.log(\"Default cache test:\", cacheCall);\n  if (cacheCall && cacheCall[1] === \"public, max-age=1800\") {\n    console.log(\"PASS: Default cache is 1800 seconds\");\n  } else {\n    console.log(\"FAIL: Default cache should be 1800 seconds\");\n  }\n}\n\nasync function testCustomCache() {\n  mock.reset();\n  mock.onPost(\"https://api.github.com/graphql\").reply(200, statsData);\n  \n  const req = { query: { username: \"test\", cache_seconds: \"3600\" } };\n  const res = {\n    setHeader: jest.fn(),\n    send: jest.fn(),\n  };\n  \n  await api(req, res);\n  \n  // Check that Cache-Control is set with cus"]
[524.799367, "i", "tom value\n  const cacheCall = res.setHeader.mock.calls.find(call => call[0] === \"Cache-Control\");\n  console.log(\"Custom cache test:\", cacheCall);\n  if (cacheCall && cacheCall[1] === \"public, max-age=3600\") {\n    console.log(\"PASS: Custom cache is 3600 seconds\");\n  } else {\n    console.log(\"FAIL: Custom cache should be 3600 seconds\");\n  }\n}\n\nconsole.log(\"Testing cache implementation...\");\ntestDefaultCache().then(() => testCustomCache());\nEOF\n"]
