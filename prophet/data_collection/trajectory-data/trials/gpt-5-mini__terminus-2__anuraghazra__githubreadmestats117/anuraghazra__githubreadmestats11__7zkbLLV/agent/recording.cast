[105.991711, "o", "\u001b[?2004l\r"]
[105.992912, "o", "const { request } = require(\"./utils\");\r\nconst retryer = require(\"./retryer\");\r\n\r\nconst fetcher = (variables, token) => {\r\n  return request(\r\n    {\r\n      query: `\r\n      fragment RepoInfo on Repository {"]
[105.992949, "o", "\r\n        name\r\n        nameWithOwner\r\n        isPrivate\r\n        isArchived\r\n        stargazers {\r\n          totalCount\r\n        }\r\n        description\r\n"]
[105.992977, "o", "        primaryLanguage {\r\n          color\r\n          id\r\n          name\r\n        }\r\n        forkCount\r\n      }\r\n      query getRepo($login: String!, $repo: String!) {\r\n        user(login: $login) {\r\n          repository(name: $repo) {\r\n            ...RepoInfo\r\n          }\r\n        }\r\n        organization(login: $login) {\r\n          repository(name: $repo) {\r\n            ...RepoInfo\r\n          }\r\n"]
[105.993008, "o", "        }\r\n      }\r\n    `,\r\n      variables,\r\n    },\r\n    {\r\n      Authorization: `bearer ${token}`,\r\n    }\r\n  );\r\n};\r\n\r\nasync function fetchRepo(username, reponame) {\r\n"]
[105.993029, "o", "  if (!username || !reponame) {\r\n    throw new Error(\"Invalid username or reponame\");\r\n  }\r\n\r\n  let res = await retryer(fetcher, { login: username, repo: reponame });\r\n\r\n  const data = res.data.data;\r\n\r\n  if (!data.user && !data.organization) {\r\n"]
[105.99305, "o", "    throw new Error(\"Not found\");\r\n  }\r\n\r\n  const isUser = data.organization === null && data.user;\r\n  const isOrg = data.user === null && data.organization;\r\n\r\n  if (isUser) {\r\n    if (!data.user.repository || data.user.repository.isPrivate) {\r\n      throw new Error(\"User Repository Not found\");\r\n    }"]
[105.993074, "o", "\r\n    return data.user.repository;\r\n  }\r\n\r\n  if (isOrg) {\r\n    if (\r\n      !data.organization.repository ||\r\n      data.organization.repository.isPrivate\r\n    ) {\r\n"]
[105.993094, "o", "      throw new Error(\"Organization Repository Not found\");\r\n    }\r\n    return data.organization.repository;\r\n  }\r\n}\r\n\r\nmodule.exports = fetchRepo;\r\n"]
