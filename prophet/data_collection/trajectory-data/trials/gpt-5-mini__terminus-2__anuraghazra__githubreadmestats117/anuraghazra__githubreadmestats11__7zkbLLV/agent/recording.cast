[128.823406, "i", "cat > src/cache.js << 'EOF'\n// Minimal cache utility to allow custom cache injection\n// Default implementation uses a Map and simple TTL via setTimeout when ttl is provided.\nclass DefaultCache {\n  constructor() {\n    this.store = new Map();\n    this.timers = new Map();\n  }\n\n  get(key) {\n    return this.store.has(key) ? this.store.get(key) : undefined;\n  }\n\n  set(key, value, ttl) {\n    this.store.set(key, value);\n    if (this.timers.has(key)) {\n      clearTimeout(this.timers.get(key));\n      this.timers.delete(key);\n    }\n    if (typeof ttl === 'number' && ttl > 0) {\n      const t = setTimeout(() => {\n        this.store.delete(key);\n        this.timers.delete(key);\n      }, ttl);\n      // Keep timer ref to allow clearing if overwritten\n      this.timers.set(key, t);\n    }\n  }\n\n  has(key) {\n    return this.store.has(key);\n  }\n\n  del(key) {\n    if (this.timers.has(key)) {\n      clearTimeout(this.timers.get(key));\n      this.timers.delete(key);\n    }\n    return this.store.delete(key);\n  }\n\n  clear() {\n    for (co"]
[128.823511, "i", "nst t of this.timers.values()) clearTimeout(t);\n    this.timers.clear();\n    this.store.clear();\n  }\n}\n\nmodule.exports = {\n  DefaultCache,\n  getCache: (options) => {\n    if (options && options.cache) return options.cache;\n    if (!global.__GRS_DEFAULT_CACHE__) global.__GRS_DEFAULT_CACHE__ = new DefaultCache();\n    return global.__GRS_DEFAULT_CACHE__;\n  }\n};\nEOF\n"]
