[436.868764, "o", "require(\"dotenv\").config();\r\nconst { renderError, parseBoolean } = require(\"../src/utils\");\r\nconst fetchStats = require(\"../src/fetchStats\");\r\nconst renderStatsCard = require(\"../src/renderStatsCard\");\r\n\r\nmodule.exports = async (req, res) => {\r\n  const {\r\n    username,\r\n    hide,\r\n    hide_title,\r\n    hide_border,\r\n    hide_rank,\r\n    show_icons,\r\n"]
