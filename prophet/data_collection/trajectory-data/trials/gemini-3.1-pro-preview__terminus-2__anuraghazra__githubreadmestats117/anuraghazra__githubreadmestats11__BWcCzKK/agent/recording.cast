[1084.618814, "o", "  );\r\n\r\n  return { titleColor, iconColor, textColor, bgColor };\r\n}\r\n\r\n\r\nfunction clampValue(number, min, max) {\r\n  if (Number.isNaN(parseInt(number))) return min;\r\n  if (number < min) return min;\r\n  if (number > max) return max;\r\n  return number;\r\n}\r\n\r\nmodule.exports = {\r\n"]
[1084.618868, "o", "  clampValue,\r\n  renderError,\r\n  kFormatter,\r\n  encodeHTML,\r\n  isValidHexColor,\r\n  request,\r\n  parseBoolean,\r\n"]
