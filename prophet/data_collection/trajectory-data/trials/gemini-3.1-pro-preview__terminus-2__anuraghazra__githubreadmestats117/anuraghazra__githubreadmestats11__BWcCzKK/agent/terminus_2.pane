  return { titleColor, iconColor, textColor, bgColor };
}


function clampValue(number, min, max) {
  if (Number.isNaN(parseInt(number))) return min;
  if (number < min) return min;
  if (number > max) return max;
  return number;
}

module.exports = {
  clampValue,
  renderError,
  kFormatter,
  encodeHTML,
  isValidHexColor,
  request,
  parseBoolean,
  fallbackColor,
  FlexLayout,
  getCardColors,
};
